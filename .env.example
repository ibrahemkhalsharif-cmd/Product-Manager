# Copy this file to .env and fill in your own values. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_mariadb_password
DB_NAME=shop_db

# Required: a long random text (at least 16 characters). Generate one with:
#   py -3.15 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-text

# Optional (defaults shown)
# DB_SSL_DISABLED=true          # default: true for localhost, false for any other host
# DB_CONNECT_TIMEOUT=5
# APP_HOST=127.0.0.1
# APP_PORT=5000
# APP_DEBUG=false
# SESSION_COOKIE_SECURE=false   # set to true when the site is served over HTTPS
